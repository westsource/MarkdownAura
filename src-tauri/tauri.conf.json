{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownAura",
  "version": "0.1.1",
  "identifier": "dev.westsource.markdownaura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY.md": "THIRD-PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3ODA3QzgxQzRGMTk4REQKUldUZG1QSEVnWHlBSnc5bEViT0orc0pybm1VMzVrOVpmSkttcmw0ZE96RVRWVUNyaGRza0huTkQK",
      "endpoints": [
        "https://github.com/westsource/MarkdownAura/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
