{
  "name": "markdownaura",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "A small, fast markdown reader for Windows and Linux — read-only by default, editable on request, with mermaid, dot and d2 rendering locally",
  "license": "MIT",
  "author": "道荣（黄超）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:rawhtml": "node design/check-raw-html.mjs",
    "check:prose": "node design/check-prose-css.mjs",
    "notices": "node tools/make-notices.mjs",
    "build:prod": "npm run build && npm run build:prod:rust",
    "build:prod:rust": "cargo build --release -j 1 --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@d2lang/d2": "^0.1.34",
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "katex": "^0.17.0",
    "mermaid": "^12",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/prismjs": "^1.26.6",
    "typescript": "^5.6",
    "vite": "^6"
  }
}
